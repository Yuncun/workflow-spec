        },
        {
          "uses": "test/save-text@1.0.0",
          "inputs": { "folder": "/original", "name": "other.txt", "text": "more" },
          "outputs": { "path": "/original/other.txt" },
          "status": "succeeded"
        }
      ]
    }
  }
}
