{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wfspec:schema:step",
  "title": "Step manifest",
  "description": "A published, versioned unit of work. name, title, description, inputSchema and outputSchema are the fields of an MCP tool definition; the rest say how the step behaves and how it runs. See SPEC.md, section 5.",
  "type": "object",
  "required": [
    "name",
    "version",
    "description",
    "inputSchema",
    "outputSchema",
    "effects",
    "runtime"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "$ref": "#/$defs/name"
    },
    "version": {
      "$ref": "#/$defs/version"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "inputSchema": {
      "$ref": "#/$defs/objectSchema"
    },
    "outputSchema": {
      "$ref": "#/$defs/objectSchema"
    },
    "effects": {
      "enum": [
        "none",
        "reads",
        "writes"
      ]
    },
    "deterministic": {
      "type": "boolean"
    },
    "maySkip": {
      "type": "boolean",
      "description": "The step can finish by skipping: it gives a reason instead of outputs, and the steps that depend on it are skipped (SPEC.md, section 9.6)."
    },
    "secrets": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]*$"
      },
      "uniqueItems": true
    },
    "calls": {
      "description": "The exact step versions this step may call while it runs (SPEC.md, section 5.4).",
      "type": "array",
      "items": {
        "$ref": "#/$defs/stepRef"
      },
      "uniqueItems": true
    },
    "runtime": {
      "$ref": "#/$defs/runtime"
    },
    "examples": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "inputs"
        ],
        "properties": {
          "inputs": {
            "type": "object"
          },
          "outputs": {
            "type": "object"
          }
        },
        "patternProperties": { "^x-": {} },
        "additionalProperties": false
      }
    }
  },
  "patternProperties": {
    "^x-": {}
  },
  "additionalProperties": false,
  "$defs": {
    "name": {
      "description": "owner/name, lowercase. The owner may contain _, the name may not.",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*/[a-z0-9][a-z0-9-]*$"
    },
    "version": {
      "description": "Semantic version: MAJOR.MINOR.PATCH, optionally with a pre-release tag.",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$"
    },
    "stepRef": {
      "description": "owner/name@version, with an exact version.",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*/[a-z0-9][a-z0-9-]*@(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$"
    },
    "objectSchema": {
      "description": "A JSON Schema (2020-12) for an object whose properties are the named inputs or outputs.",
      "type": "object",
      "required": [
        "type",
        "properties"
      ],
      "properties": {
        "type": {
          "const": "object"
        },
        "properties": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
          }
        },
        "required": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "runtime": {
      "description": "How the step runs: an object with exactly one key, the runtime kind. The kind is workflow, defined in SPEC.md, section 5.3, whose fields are fixed here; process, container, agent or mcp, described in drafts/runtime.md, whose fields are open, so a change to a draft doesn't make manifests invalid; or a platform's own kind, whose name starts with x-.",
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "workflow": {
          "type": "object",
          "required": [
            "path",
            "digest"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "digest": {
              "$ref": "urn:wfspec:schema:lock#/$defs/digest"
            }
          },
          "patternProperties": { "^x-": {} },
          "additionalProperties": false
        }
      },
      "additionalProperties": {
        "type": "object"
      },
      "propertyNames": {
        "pattern": "^(process|container|agent|mcp|workflow|x-.+)$"
      }
    }
  }
}
