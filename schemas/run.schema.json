{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wfspec:schema:run",
  "title": "Run record",
  "description": "What happened when a workflow ran: which step versions, with which inputs, giving which outputs. Enough to rerun it or save it as a new workflow. See SPEC.md, section 9.9.",
  "type": "object",
  "required": [
    "id",
    "workflow",
    "lock",
    "inputs",
    "status",
    "created",
    "steps"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "workflow": {
      "type": "object",
      "required": [
        "digest"
      ],
      "properties": {
        "name": {
          "$ref": "urn:wfspec:schema:step#/$defs/name"
        },
        "version": {
          "$ref": "urn:wfspec:schema:step#/$defs/version"
        },
        "digest": {
          "$ref": "urn:wfspec:schema:lock#/$defs/digest"
        }
      },
      "additionalProperties": false
    },
    "lock": {
      "$ref": "urn:wfspec:schema:lock"
    },
    "inputs": {
      "type": "object"
    },
    "outputs": {
      "type": "object"
    },
    "status": {
      "enum": [
        "queued",
        "running",
        "succeeded",
        "failed",
        "cancelled"
      ]
    },
    "error": {
      "description": "Why the run failed or never started, for example 'check_failed' with the checker's result in the message.",
      "type": "object",
      "required": [
        "message"
      ],
      "properties": {
        "message": {
          "type": "string"
        },
        "code": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "caller": {
      "type": "string"
    },
    "created": {
      "type": "string",
      "format": "date-time"
    },
    "started": {
      "type": "string",
      "format": "date-time"
    },
    "ended": {
      "type": "string",
      "format": "date-time"
    },
    "traceId": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "steps": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/stepRun"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "stepRun": {
      "type": "object",
      "required": [
        "uses",
        "status"
      ],
      "properties": {
        "uses": {
          "$ref": "urn:wfspec:schema:step#/$defs/stepRef"
        },
        "digest": {
          "$ref": "urn:wfspec:schema:lock#/$defs/digest"
        },
        "status": {
          "enum": [
            "pending",
            "running",
            "succeeded",
            "failed",
            "skipped",
            "not_needed"
          ]
        },
        "reason": {
          "description": "Why the step was skipped or not needed.",
          "type": "string"
        },
        "cacheKey": {
          "$ref": "urn:wfspec:schema:lock#/$defs/digest"
        },
        "cacheHit": {
          "type": "boolean"
        },
        "attempts": {
          "type": "integer",
          "minimum": 0
        },
        "inputs": {
          "type": "object"
        },
        "outputs": {
          "type": "object"
        },
        "started": {
          "type": "string",
          "format": "date-time"
        },
        "ended": {
          "type": "string",
          "format": "date-time"
        },
        "logs": {
          "$ref": "urn:wfspec:file"
        },
        "error": {
          "type": "object",
          "required": [
            "message"
          ],
          "properties": {
            "message": {
              "type": "string"
            },
            "code": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "calls": {
          "description": "The steps this step called while it ran, in order (SPEC.md, section 9.8).",
          "type": "array",
          "items": {
            "$ref": "#/$defs/call"
          }
        },
        "steps": {
          "description": "For a step whose runtime is a workflow: how the steps inside it ran.",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/stepRun"
          }
        }
      },
      "additionalProperties": false
    },
    "call": {
      "type": "object",
      "required": [
        "uses",
        "inputs",
        "status"
      ],
      "properties": {
        "uses": {
          "$ref": "urn:wfspec:schema:step#/$defs/stepRef"
        },
        "digest": {
          "$ref": "urn:wfspec:schema:lock#/$defs/digest"
        },
        "cacheKey": {
          "$ref": "urn:wfspec:schema:lock#/$defs/digest"
        },
        "cacheHit": {
          "type": "boolean"
        },
        "attempts": {
          "type": "integer",
          "minimum": 0
        },
        "inputs": {
          "type": "object"
        },
        "outputs": {
          "type": "object"
        },
        "status": {
          "enum": [
            "succeeded",
            "failed",
            "skipped"
          ]
        },
        "reason": {
          "description": "Why the call was skipped.",
          "type": "string"
        },
        "started": {
          "type": "string",
          "format": "date-time"
        },
        "ended": {
          "type": "string",
          "format": "date-time"
        },
        "error": {
          "$ref": "#/$defs/stepRun/properties/error"
        },
        "logs": {
          "$ref": "urn:wfspec:file"
        }
      },
      "additionalProperties": false,
      "description": "A step another step called while it ran. It ran as a step, so it records the same facts."
    }
  }
}
