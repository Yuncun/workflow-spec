{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wfspec:schema:run",
  "title": "Run record",
  "description": "What happened when a workflow ran: which step versions, with which inputs, giving which outputs. Enough to rerun it or save it as a new workflow. See SPEC.md, section 9.10.",
  "type": "object",
  "required": [
    "id",
    "workflow",
    "lock",
    "inputs",
    "status",
    "created",
    "steps"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "workflow": {
      "type": "object",
      "required": [
        "digest"
      ],
      "properties": {
        "name": {
          "$ref": "urn:wfspec:schema:step#/$defs/name"
        },
        "version": {
          "$ref": "urn:wfspec:schema:step#/$defs/version"
        },
        "digest": {
          "$ref": "urn:wfspec:schema:lock#/$defs/digest"
        }
      },
      "additionalProperties": false
    },
    "lock": {
      "$ref": "urn:wfspec:schema:lock"
    },
    "inputs": {
      "type": "object"
    },
    "outputs": {
      "type": "object"
    },
    "status": {
      "enum": [
        "queued",
        "running",
        "succeeded",
        "failed",
        "cancelled"
      ]
    },
    "error": {
      "description": "Why the run failed or never started: 'check_failed', 'invalid_input' or 'lock_mismatch' for a run that never started, otherwise the code of the first step that failed.",
      "type": "object",
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "message": {
          "type": "string"
        },
        "code": {
          "anyOf": [
            { "enum": [
            "check_failed",
            "invalid_input",
            "lock_mismatch",
            "invalid_output",
            "pinned_mismatch",
            "timeout",
            "failed"
          ] },
            { "type": "string", "pattern": "^x-", "description": "A platform's own code." }
          ]
        }
      },
      "additionalProperties": false
    },
    "caller": {
      "type": "string"
    },
    "created": {
      "type": "string",
      "format": "date-time"
    },
    "started": {
      "type": "string",
      "format": "date-time"
    },
    "ended": {
      "type": "string",
      "format": "date-time"
    },
    "traceId": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "steps": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/stepRun"
      }
    }
  },
  "patternProperties": { "^x-": {} },
  "additionalProperties": false,
  "$defs": {
    "stepRun": {
      "type": "object",
      "required": [
        "uses",
        "status"
      ],
      "properties": {
        "uses": {
          "$ref": "urn:wfspec:schema:step#/$defs/stepRef"
        },
        "digest": {
          "$ref": "urn:wfspec:schema:lock#/$defs/digest"
        },
        "status": {
          "enum": [
            "pending",
            "running",
            "succeeded",
            "failed",
            "skipped",
            "not_needed"
          ]
        },
        "reason": {
          "description": "Why the step was skipped or not needed.",
          "type": "string"
        },
        "cacheKey": {
          "$ref": "urn:wfspec:schema:lock#/$defs/digest"
        },
        "cacheHit": {
          "type": "boolean"
        },
        "attempts": {
          "type": "integer",
          "minimum": 0
        },
        "inputs": {
          "type": "object"
        },
        "outputs": {
          "type": "object"
        },
        "started": {
          "type": "string",
          "format": "date-time"
        },
        "ended": {
          "type": "string",
          "format": "date-time"
        },
        "logs": {
          "$ref": "urn:wfspec:file"
        },
        "error": {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "message": {
              "type": "string"
            },
            "code": {
              "anyOf": [
                { "enum": [
                "invalid_input",
                "invalid_output",
                "pinned_mismatch",
                "timeout",
                "failed"
              ] },
                { "type": "string", "pattern": "^x-", "description": "A platform's own code." }
              ]
            }
          },
          "additionalProperties": false
        },
        "calls": {
          "description": "The steps this step called while it ran, in order (SPEC.md, section 9.9).",
          "type": "array",
          "items": {
            "$ref": "#/$defs/call"
          }
        },
        "steps": {
          "description": "For a step whose runtime is a workflow: how the steps inside it ran.",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/stepRun"
          }
        }
      },
      "patternProperties": { "^x-": {} },
      "additionalProperties": false
    },
    "call": {
      "type": "object",
      "required": [
        "uses",
        "digest",
        "inputs",
        "status"
      ],
      "if": {
        "properties": {
          "status": {
            "const": "succeeded"
          }
        }
      },
      "then": {
        "required": [
          "outputs"
        ]
      },
      "properties": {
        "uses": {
          "$ref": "urn:wfspec:schema:step#/$defs/stepRef"
        },
        "digest": {
          "$ref": "urn:wfspec:schema:lock#/$defs/digest"
        },
        "cacheKey": {
          "$ref": "urn:wfspec:schema:lock#/$defs/digest"
        },
        "cacheHit": {
          "type": "boolean"
        },
        "attempts": {
          "type": "integer",
          "minimum": 0
        },
        "inputs": {
          "type": "object"
        },
        "outputs": {
          "type": "object"
        },
        "status": {
          "enum": [
            "succeeded",
            "failed",
            "skipped"
          ]
        },
        "reason": {
          "description": "Why the call was skipped.",
          "type": "string"
        },
        "started": {
          "type": "string",
          "format": "date-time"
        },
        "ended": {
          "type": "string",
          "format": "date-time"
        },
        "error": {
          "$ref": "#/$defs/stepRun/properties/error"
        },
        "logs": {
          "$ref": "urn:wfspec:file"
        },
        "calls": {
          "description": "The steps this call called while it ran, in order.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/call"
          }
        },
        "steps": {
          "description": "For a call to a workflow step: how the steps inside it ran.",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/stepRun"
          }
        }
      },
      "patternProperties": { "^x-": {} },
      "additionalProperties": false,
      "description": "A step another step called while it ran. It ran as a step, so it records the same facts."
    }
  }
}
