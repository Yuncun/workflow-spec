{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wfspec:schema:workflow",
  "title": "Workflow",
  "description": "Published steps wired together by name. A published workflow is itself a step. See SPEC.md, section 5.",
  "type": "object",
  "required": ["steps"],
  "properties": {
    "$schema": { "type": "string" },
    "name": { "$ref": "urn:wfspec:schema:step#/$defs/name" },
    "version": { "$ref": "urn:wfspec:schema:step#/$defs/version" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "inputSchema": { "$ref": "urn:wfspec:schema:step#/$defs/objectSchema" },
    "outputs": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$" },
      "additionalProperties": { "$ref": "#/$defs/reference" }
    },
    "steps": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][a-z0-9_-]*$" },
      "additionalProperties": { "$ref": "#/$defs/step" }
    }
  },
  "patternProperties": { "^x-": {} },
  "additionalProperties": false,
  "$defs": {
    "reference": {
      "description": "inputs.<name> or steps.<id>.outputs.<name>.",
      "type": "object",
      "required": ["from"],
      "properties": { "from": { "type": "string" } },
      "additionalProperties": false
    },
    "step": {
      "type": "object",
      "required": ["uses"],
      "properties": {
        "uses": { "$ref": "urn:wfspec:schema:step#/$defs/stepRef" },
        "description": { "type": "string" },
        "with": {
          "description": "Input name to value. A value is a literal, a reference ({from: ...}), or a wrapped literal ({literal: ...}).",
          "type": "object"
        }
      },
      "patternProperties": { "^x-": {} },
      "additionalProperties": false
    }
  }
}
