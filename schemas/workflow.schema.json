{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wfspec:schema:workflow",
  "title": "Workflow",
  "description": "Published steps wired together by name. A published workflow is itself a step. See SPEC.md, section 7.",
  "type": "object",
  "required": ["steps"],
  "properties": {
    "$schema": { "type": "string" },
    "name": { "$ref": "urn:wfspec:schema:step#/$defs/name" },
    "version": { "$ref": "urn:wfspec:schema:step#/$defs/version" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "inputSchema": { "$ref": "urn:wfspec:schema:step#/$defs/objectSchema" },
    "outputs": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$" },
      "additionalProperties": { "$ref": "#/$defs/reference" }
    },
    "steps": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][a-z0-9_-]*$" },
      "additionalProperties": { "$ref": "#/$defs/step" }
    },
    "subgraphs": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9_-]*$" },
      "additionalProperties": { "$ref": "#/$defs/subgraph" }
    }
  },
  "patternProperties": { "^x-": {} },
  "additionalProperties": false,
  "$defs": {
    "reference": {
      "description": "inputs.<name> or steps.<id>.outputs.<name>.",
      "type": "object",
      "required": ["from"],
      "properties": { "from": { "description": "A from that isn't text is reported as bad_reference by checking, not by this schema." } },
      "additionalProperties": false
    },
    "step": {
      "type": "object",
      "required": ["uses"],
      "properties": {
        "uses": { "$ref": "#/$defs/uses" },
        "with": {
          "description": "Input name to value. A value is a literal, a reference ({from: ...}), or a wrapped literal ({literal: ...}).",
          "type": "object"
        }
      },
      "patternProperties": { "^x-": {} },
      "additionalProperties": false
    },
    "uses": {
      "description": "A published step's owner/name@version, or subgraphs.<name> for a subgraph in this file.",
      "anyOf": [
        { "$ref": "urn:wfspec:schema:step#/$defs/stepRef" },
        { "type": "string", "pattern": "^subgraphs\\.[a-z][a-z0-9_-]*$" }
      ]
    },
    "subgraph": {
      "description": "A workflow kept in this file, without a name, version or subgraphs of its own. See SPEC.md, section 7.5.",
      "type": "object",
      "required": ["steps"],
      "properties": {
        "title": { "$ref": "#/properties/title" },
        "description": { "$ref": "#/properties/description" },
        "inputSchema": { "$ref": "#/properties/inputSchema" },
        "outputs": { "$ref": "#/properties/outputs" },
        "steps": { "$ref": "#/properties/steps" }
      },
      "patternProperties": { "^x-": {} },
      "additionalProperties": false
    }
  }
}
